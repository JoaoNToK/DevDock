# DevDock — Environment Variables Configuration Template
# Copy this file to .env.local and fill in your credentials

# Application URL & Authentication (NextAuth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_key_min_32_chars

# Database (PostgreSQL / Supabase Prisma Connection)
DATABASE_URL="postgresql://postgres:your_password@db.your_supabase_ref.supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:your_password@db.your_supabase_ref.supabase.co:5432/postgres"

# Google OAuth 2.0 Credentials (Optional - Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Web Push Notifications (Optional - VAPID Keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@devdock.app
