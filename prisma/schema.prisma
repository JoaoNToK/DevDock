datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------
// 1. AUTENTICAÇÃO E USUÁRIOS
// ------------------------------------
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  projects           Project[]
  studies            StudySubject[]
  academicCourses    AcademicCourse[]
  academicLinks      AcademicLink[]
  academicFiles      AcademicAttachmentFile[]
  categories         Category[]
  calendarEvents     CalendarEvent[]
  planningActivities PlanningActivity[]
  pomodoroSessions   PomodoroSession[]
  pomodoroTasks      PomodoroTask[]
  userSettings       UserSettings?
  pushSubscriptions  PushSubscription[]
  projectMembers     ProjectMember[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------
// 2. MÓDULO CATEGORIAS PERSONALIZADAS
// ------------------------------------
model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#6366F1")
  icon      String   @default("folder")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------
// 3. MÓDULO PROJETOS & KANBAN
// ------------------------------------
model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  category    String   @default("Desenvolvimento")
  status      String   @default("em_andamento")
  color       String   @default("#5379AE")
  icon        String   @default("rocket_launch")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  columns     ProjectColumn[]
  tasks       ProjectTask[]
  notes       ProjectNote[]
  goals       ProjectGoal[]
  docs        ProjectDoc[]
  files       ProjectFile[]
  members     ProjectMember[]
  invites     ProjectInvite[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  email     String
  role      String   @default("editor") // "owner" | "editor" | "viewer"
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model ProjectInvite {
  id          String   @id @default(cuid())
  projectId   String
  code        String   @unique
  role        String   @default("editor") // "editor" | "viewer"
  createdById String
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectColumn {
  id        String   @id @default(cuid())
  projectId String
  name      String
  color     String
  order     Int
  createdAt DateTime @default(now())

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     ProjectTask[]
}

model ProjectTask {
  id          String    @id @default(cuid())
  projectId   String
  columnId    String
  title       String
  description String?
  priority    String    @default("media")
  dueDate     DateTime?
  completed   Boolean   @default(false)
  tags        String[]
  checklist   Json?
  subtasks    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column      ProjectColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
}

model ProjectNote {
  id         String   @id @default(cuid())
  projectId  String
  title      String
  content    String   @db.Text
  tags       String[]
  isPinned   Boolean  @default(false)
  isArchived Boolean  @default(false)
  taskId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectGoal {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  targetDate  DateTime?
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectDoc {
  id        String   @id @default(cuid())
  projectId String
  title     String
  content    String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectFile {
  id              String   @id @default(cuid())
  projectId       String
  name            String
  size            Int
  type            String
  url             String
  storageUrl      String?
  storagePath     String?
  storageProvider String?  @default("local")
  uploadedAt      DateTime @default(now())

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ------------------------------------
// 4. MÓDULO ESTUDOS & CONTEÚDOS
// ------------------------------------
model StudySubject {
  id          String   @id @default(cuid())
  userId      String
  name        String
  color       String
  icon        String   @default("menu_book")
  description String?
  createdAt   DateTime @default(now())

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics      StudyTopic[]
  sessions    StudySession[]
  notes       StudyNote[]
  revisions   StudyRevision[]
}

model StudyTopic {
  id        String   @id @default(cuid())
  subjectId String
  title     String
  status    String   @default("pendente")
  priority  String   @default("media")
  createdAt DateTime @default(now())

  subject   StudySubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model StudySession {
  id        String   @id @default(cuid())
  subjectId String
  duration  Int
  notes     String?
  date      DateTime @default(now())

  subject   StudySubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model StudyNote {
  id         String   @id @default(cuid())
  subjectId  String
  title      String
  content    String   @db.Text
  tags       String[]
  isPinned   Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  subject    StudySubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model StudyRevision {
  id        String   @id @default(cuid())
  subjectId String
  topic     String
  dueDate   DateTime
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  subject   StudySubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

// ------------------------------------
// 5. MÓDULO FACULDADE & RECURSOS ACADÊMICOS
// ------------------------------------
model AcademicCourse {
  id          String   @id @default(cuid())
  userId      String
  courseName  String
  institution String?
  startYear   Int
  endYear     Int?
  createdAt   DateTime @default(now())

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  semesters   AcademicSemester[]
}

model AcademicSemester {
  id        String   @id @default(cuid())
  courseId  String
  number    Int
  year      Int
  period    String
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  course    AcademicCourse    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subjects  AcademicSubject[]
}

model AcademicSubject {
  id          String   @id @default(cuid())
  semesterId  String
  name        String
  code        String?
  professor   String?
  room        String?
  schedule    String?
  color       String   @default("#0474C4")
  createdAt   DateTime @default(now())

  semester    AcademicSemester     @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  assessments AcademicAssessment[]
  links       AcademicLink[]
  files       AcademicAttachmentFile[]
}

model AcademicAssessment {
  id        String   @id @default(cuid())
  subjectId String
  title     String
  type      String   // "prova" | "trabalho" | "atividade" | "apresentacao"
  dueDate   DateTime
  weight    Float?
  grade     Float?
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  subject   AcademicSubject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  links     AcademicLink[]
  files     AcademicAttachmentFile[]
}

model AcademicLink {
  id           String   @id @default(cuid())
  userId       String
  subjectId    String?
  assignmentId String?
  deliveryName String?
  title        String
  url          String   @db.Text
  description  String?  @db.Text
  category     String?
  resourceType String?  @default("repo")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject    AcademicSubject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  assignment AcademicAssessment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
}

model AcademicAttachmentFile {
  id              String   @id @default(cuid())
  userId          String
  subjectId       String?
  assignmentId    String?
  deliveryName    String?
  name            String
  size            Int
  type            String
  resourceType    String?  @default("other")
  dataUrl         String?  @db.Text
  storageUrl      String?
  storagePath     String?
  storageProvider String?  @default("local")
  uploadedAt      DateTime @default(now())

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject    AcademicSubject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  assignment AcademicAssessment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
}

// ------------------------------------
// 6. CALENDÁRIO & PLANEJAMENTO
// ------------------------------------
model CalendarEvent {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  date        String   // YYYY-MM-DD
  startTime   String?  // HH:mm
  endTime     String?  // HH:mm
  category    String   @default("pessoal")
  color       String   @default("#5379AE")
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlanningActivity {
  id         String   @id @default(cuid())
  userId     String
  title      String
  dateString String   // YYYY-MM-DD
  time       String?  // HH:mm
  category   String   @default("geral")
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------
// 7. POMODORO TIMER & TAREFAS DE GOOGLE TASKS STYLE
// ------------------------------------
model PomodoroSession {
  id          String   @id @default(cuid())
  userId      String
  mode        String   // "focus" | "shortBreak" | "longBreak" | "stopwatch"
  duration    Int
  completedAt DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PomodoroTask {
  id                 String   @id @default(cuid())
  userId             String
  title              String
  description        String?  @db.Text
  subtasks           Json?
  category           String   @default("geral")
  priority           String   @default("medium")
  tags               String[]
  estimatedPomodoros Int      @default(1)
  completedPomodoros Int      @default(0)
  completed          Boolean  @default(false)
  isStarred          Boolean  @default(false)
  projectId          String?
  dateString         String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  theme              String   @default("system")
  focusDuration      Int      @default(25)
  shortBreakDuration Int      @default(5)
  longBreakDuration  Int      @default(15)
  volume             Float    @default(0.8)
  dailyGoal          Int      @default(8)
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------
// 8. WEB PUSH SUBSCRIPTIONS
// ------------------------------------
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
}
